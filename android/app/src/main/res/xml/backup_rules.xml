<?xml version="1.0" encoding="utf-8"?>
<!-- Fail-closed Auto Backup rules for API < 31. allowBackup=false already
     disables backup; these excludes keep the policy unambiguous. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
