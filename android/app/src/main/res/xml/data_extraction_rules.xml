<?xml version="1.0" encoding="utf-8"?>
<!-- Fail-closed Android 12+ extraction: no cloud backup and no device transfer
     of local app data (WebView / localStorage health-adjacent state).
     No include rules — excludes only. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
