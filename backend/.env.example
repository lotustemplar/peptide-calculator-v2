# Names only in git. Put real values in backend/.env or in the Vercel project.
# Neon marketplace integration supplies the database URLs.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
PUBLIC_APP_URL=https://peptide-calculator-v2-snowy.vercel.app

# Local `npm start` only. Vercel does not use PORT.
PORT=8787
